# Copy to .env and point at your ICPAC servers.

# --- Endpoints ---------------------------------------------------------
# One or more OGC endpoints: "name=url[|services=WMS,WFS]" separated by ';'.
# The URL is the OWS entry point, e.g. .../geoserver/ows
ICPAC_ENDPOINTS=geoportal=https://geoportal.icpac.net/geoserver/ows

# Several feeds at once (a geoportal plus a hazards GeoServer):
# ICPAC_ENDPOINTS=geoportal=https://host-a/geoserver/ows;hazards=https://host-b/geoserver/ows|services=WMS,WFS

# Single-endpoint shorthand, used only when ICPAC_ENDPOINTS is unset:
# ICPAC_OGC_URL=https://geoportal.icpac.net/geoserver/ows

# --- Authentication (only if your servers require it) ------------------
ICPAC_OGC_USER=
ICPAC_OGC_PASSWORD=
ICPAC_OGC_TOKEN=

# --- Tuning ------------------------------------------------------------
ICPAC_TIMEOUT=45              # seconds per OGC request
ICPAC_CONCURRENCY=6           # parallel requests across all feeds
ICPAC_RETRIES=2               # retries on timeout / 5xx, with backoff
ICPAC_CAPABILITIES_TTL=1800   # seconds to cache GetCapabilities
ICPAC_DATA_TTL=120            # seconds to cache data responses
ICPAC_SAMPLE_GRID=8           # NxN GetFeatureInfo grid for the WMS fallback
ICPAC_MAX_COVERAGE_PX=512     # largest WCS window requested, per side
ICPAC_VERIFY_TLS=true         # leave true unless your server uses a private CA
