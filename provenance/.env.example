# Every value here has a working default; nothing needs setting to run locally.

# PROVENANCE_DB=./data/provenance.db
# PROVENANCE_CORPUS=./data/corpus.db
# PROVENANCE_UPLOADS=./data/uploads
# PROVENANCE_MAX_UPLOAD_MB=20

# Set behind HTTPS in production so the session cookie is Secure.
# PROVENANCE_SECURE_COOKIES=1

# Fabricated reports for demos. Every report is stamped is_mock and the UI
# shows a banner. Never set this on a deployment anyone relies on.
# PROVENANCE_DEMO_MODE=1

# Path to a fitted AI-detection calibration. Absent means AI detection does not
# run, which is the correct default until you have fitted one against your own
# held-out control set. See docs/AI_DETECTION.md.
# PROVENANCE_CALIBRATION=./data/calibration.json

# Free-tier LLM keys. Used only for report prose, paraphrase adjudication and
# generating classifier training data -- never to decide a verdict.
# CEREBRAS_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
