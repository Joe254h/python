# Copy to .env and fill in what you have. Every key is optional: an actor
# without its credential stays dormant and says so in the run log.

# --- X / Twitter -------------------------------------------------------
# developer.x.com -> Project -> Keys and tokens -> Bearer Token
X_BEARER_TOKEN=

# --- YouTube -----------------------------------------------------------
# console.cloud.google.com -> enable "YouTube Data API v3" -> create API key
# Without this the YouTube actor falls back to public RSS (no view counts).
YOUTUBE_API_KEY=

# --- Facebook / Instagram (Meta Graph API) -----------------------------
# developers.facebook.com -> app -> Graph API Explorer -> long-lived token
META_ACCESS_TOKEN=
# Needed only for Instagram: your own IG Business account id
IG_BUSINESS_ACCOUNT_ID=

# --- TikTok ------------------------------------------------------------
# developers.tiktok.com -> Research API (approval required)
TIKTOK_ACCESS_TOKEN=

# --- Open web search (either one is enough) ----------------------------
SERPER_API_KEY=
BRAVE_API_KEY=

# --- Behaviour ---------------------------------------------------------
PULSESCOPE_REGION=KE
PULSESCOPE_LANG=en
PULSESCOPE_LOOKBACK_DAYS=90
PULSESCOPE_MAX_ITEMS=60
PULSESCOPE_CONCURRENCY=8
PULSESCOPE_TIMEOUT=25

# Force simulated output for demos / offline work. Leave unset for real runs.
PULSESCOPE_DEMO=
